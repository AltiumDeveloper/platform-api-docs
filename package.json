{
  "name": "platform-api-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Altium 365 API GraphQL reference documentation, organised by bounded context.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AltiumDeveloper/platform-api-docs.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "apidocs": "npm run apidocs:fetch && npm run apidocs:annotate && npm run apidocs:generate && npm run apidocs:postprocess && npm run search:index",
    "apidocs:fetch": "node scripts/apidocs/fetch-schema.mjs && node scripts/apidocs/fetch-cdm.mjs",
    "apidocs:annotate": "node scripts/apidocs/annotate.mjs",
    "apidocs:generate": "docusaurus graphql-to-doc --force",
    "apidocs:postprocess": "node scripts/apidocs/postprocess.mjs",
    "search:index": "node scripts/apidocs/search-index.mjs",
    "search:eval": "node scripts/apidocs/search-eval.mjs",
    "llms": "node scripts/apidocs/llms.mjs",
    "llms:check": "node scripts/apidocs/llms-check.mjs",
    "test": "node --test \"test/**/!(guides).test.mjs\"",
    "test:guides": "node --test test/guides.test.mjs",
    "test:smoke": "node scripts/apidocs/smoke.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-client-redirects": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/utils": "^3.10.1",
    "@giscus/react": "^3.1.0",
    "@graphql-markdown/docusaurus": "1.37.0",
    "@graphql-markdown/graphql": "1.3.0",
    "@graphql-markdown/utils": "1.13.1",
    "@graphql-tools/graphql-file-loader": "^8.1.20",
    "@mdx-js/react": "^3.0.0",
    "graphql": "^16.11.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-text": "^4.0.2",
    "minisearch": "^7.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@graphql-markdown/cli": "1.1.0",
    "@graphql-markdown/core": "1.23.0",
    "@graphql-markdown/printer-legacy": "1.18.0",
    "@graphql-markdown/helpers": "1.2.0",
    "@graphql-markdown/logger": "1.1.0",
    "@graphql-markdown/formatters": "1.1.1",
    "@graphql-markdown/types": "1.15.0",
    "@graphql-markdown/utils": "1.13.1",
    "@graphql-markdown/graphql": "1.3.0"
  }
}
